# Required for `npm run enrich` (transcripts + hook tags). Nothing else needs a key.
GROQ_API_KEY=

# Optional: Anthropic model for tagging; enables --vision (frames → founderOnCamera)
ANTHROPIC_API_KEY=
LLM_PROVIDER=            # groq | anthropic  (default: anthropic if its key is set, else groq)

# Optional: model-name overrides, only if a request 404s
GROQ_WHISPER_MODEL=
GROQ_CHAT_MODEL=
ANTHROPIC_MODEL=

# Optional: footer link on the site
NEXT_PUBLIC_REPO_URL=https://github.com/Ankitanand2411/Launch-Atlas
