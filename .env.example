# Phase 2 — enrichment (npm run enrich). Not needed for discover/analyze/dev/build.
GROQ_API_KEY=                 # Whisper transcription (whisper-large-v3-turbo) and Llama tagging
ANTHROPIC_API_KEY=            # optional: Claude tagging; enables --vision (frames → founderOnCamera)
LLM_PROVIDER=                 # groq | anthropic  (default: anthropic if its key is set, else groq)
# Model names drift; override if a request 404s.
GROQ_WHISPER_MODEL=
GROQ_CHAT_MODEL=
ANTHROPIC_MODEL=
# App
NEXT_PUBLIC_REPO_URL=https://github.com/Ankitanand2411/Launch-Atlas
